{
  "name": "kopano-sovereign-hub",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run validate:experiments && npm run validate:receipts && npm run test:receipts && npm run test:alpaca && npm run test:lefa && npm run typecheck && vite build",
    "validate:experiments": "node scripts/validate-experiment-registry.mjs",
    "validate:receipts": "node scripts/validate-external-receipts.mjs",
    "test:receipts": "node scripts/test-external-receipts.mjs",
    "test:alpaca": "node --test experiments/alpaca-sovereign-arbitrage/tests/*.test.mjs",
    "test:lefa": "node --experimental-strip-types --test tests/lefa-market-observation.test.ts",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^6.0.4",
    "typescript": "^7.0.0",
    "vite": "^8.1.5"
  }
}
